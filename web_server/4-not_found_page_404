#!/usr/bin/env bash
# Script to configure a custom 404 error page in Nginx

set -e

# Install nginx if not installed
if ! command -v nginx >/dev/null 2>&1; then
    apt-get update -y
    apt-get install nginx -y
fi

# Create custom 404 page
echo "Ceci n'est pas une page" > /var/www/html/404.html
chmod 644 /var/www/html/404.html

# Path to config
CONFIG="/etc/nginx/sites-available/default"

# Add custom error directive if missing
if ! grep -q "error_page 404 /404.html;" "$CONFIG"; then
    sed -i "/server_name _;/a \    error_page 404 /404.html;" "$CONFIG"
fi

# Reload nginx
service nginx restart

# Required output
echo "404"
